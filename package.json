{
  "name": "shrimply",
  "main": "expo-router/entry",
  "version": "3.3.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --host 127.0.0.1",
    "eas-build-pre-install": "node ./scripts/prepare-google-services.js",
    "lint": "expo lint",
    "check:android-release": "node ./scripts/check-android-release-integrity.js",
    "test:team-security": "node --test functions/teamAccessPolicy.test.js functions/teamAccessRules.test.js",
    "test:team-security:emulator": "node --test functions/teamAccessRules.emulator.test.js",
    "test": "node scripts/run-tests.cjs",
    "qa:daily": "node scripts/qa-bot/run.mjs --mode=all",
    "qa:morning": "node scripts/qa-bot/run.mjs --mode=morning",
    "qa:evening": "node scripts/qa-bot/run.mjs --mode=evening",
    "qa:orson": "node scripts/qa-bot/run.mjs --mode=orson",
    "qa:headed": "node scripts/qa-bot/run.mjs --headless=false",
    "check:orson-domain": "node scripts/sync-orson-domain.cjs --check",
    "test:orson-agent": "npm run check:orson-domain && node --require ./scripts/register-typescript.cjs --test functions/shared/orsonAgentContract.test.js functions/shared/orsonAppData.test.js functions/shared/orsonDecisionTools.test.js functions/shared/orsonInventoryPolicy.test.js shared/harvestProfitability.test.ts orson/agentState.test.cjs orson/conversationOperations.test.cjs orson/callableStream.test.ts orson/sessionUi.test.cjs web/src/app/dashboard/ai/orsonStreamingUi.test.cjs",
    "test:orson-observation-contract": "node --require ./scripts/register-typescript.cjs --test functions/shared/orsonAgentContract.source.test.cjs",
    "check": "node --require ./scripts/register-typescript.cjs --test functions/shared/orsonAgentContract.source.test.cjs orson/agentState.test.cjs orson/sessionUi.test.cjs web/src/app/dashboard/ai/orsonStreamingUi.test.cjs",
    "test:orson-agent:emulator": "firebase emulators:exec --project demo-shrimply-agent --config firebase.orson-agent-test.json --only firestore,storage \"node --test --test-concurrency=1 functions/orsonAgent.emulator.test.cjs functions/orsonAgentRules.emulator.test.cjs\"",
    "test:sop": "node --require ./scripts/register-typescript.cjs --test shared/sop/*.test.cjs functions/sop/evidence.test.cjs functions/sop/model.test.cjs functions/sop/content.test.cjs",
    "test:sop:emulator": "firebase emulators:exec --project demo-shrimply-sop --config firebase.sop-test.json --only firestore,storage \"node --test --test-concurrency=1 functions/sop/adaptive.emulator.test.cjs functions/sop/adoption.emulator.test.cjs\"",
    "test:sop:browser": "node scripts/sop/prepare-e2e.cjs && firebase emulators:exec --project demo-shrimply-agent --config firebase.sop-e2e-test.json --only auth,firestore,storage,functions \"node scripts/sop/run-browser.cjs\"",
    "test:sop:calibration": "node scripts/sop/calibrate-narrative.cjs",
    "test:sop:meta": "node scripts/sop/verify-meta.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/libre-baskerville": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "26.2.0",
    "@react-native-firebase/app-check": "26.2.0",
    "@sentry/react-native": "~7.11.0",
    "base64-js": "^1.5.1",
    "date-fns": "^4.1.0",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.16",
    "expo-auth-session": "~57.0.14",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-in-app-updates": "^0.12.0",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.2.4",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "^15.16.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
