{
  "expo": {
    "name": "Shrimply",
    "slug": "Shrimply",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/ShrimplyLogo.png",
    "scheme": "shrimply",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0.5",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby disease alerts and report outbreaks."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDSwVjn_tScDGCtm3McUadMXbNCbPH5j4g"
      },
      "bundleIdentifier": "com.shrimplytech.shrimply"
    },
    "android": {
      "package": "com.shrimplytech.shrimply",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ShrimplyLogo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDSwVjn_tScDGCtm3McUadMXbNCbPH5j4g"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/ShrimplyLogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ShrimplyLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show nearby disease alerts and report outbreaks.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bcecc2ab-013c-46d3-8fbd-10f5067d7065"
      }
    },
    "owner": "shrimply.tech"
  }
}