rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function currentSessionAllowed() {
      let user = userDoc().data;
      return signedIn() && (user == null || (user.get('founderAccessSuspended', false) != true
        && request.auth.token.get('auth_time', 0) > user.get('founderSessionValidAfter', -1)));
    }

    function companyDoc(companyId) {
      return firestore.get(/databases/(default)/documents/companies/$(companyId));
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function labReportDoc(companyId, labReportId) {
      return firestore.get(/databases/(default)/documents/companies/$(companyId)/labReports/$(labReportId));
    }

    function isCompanyMember(companyId) {
      return signedIn()
        && companyDoc(companyId).data != null
        && (
          companyDoc(companyId).data.ownerId == request.auth.uid
          || (request.auth.uid in companyDoc(companyId).data.teamMembers
            && userBelongsToCompany(companyId))
        );
    }

    function userBelongsToCompany(companyId) {
      return signedIn()
        && userDoc().data != null
        && userDoc().data.companyId == companyId;
    }

    function hasCompanyPermission(companyId, permission) {
      let user = userDoc().data;
      let overrides = user.get('permissionOverrides', {});
      let role = user.get('role', null);
      return user != null
        && user.get('founderAccessSuspended', false) != true
        && request.auth.token.get('auth_time', 0) > user.get('founderSessionValidAfter', -1)
        && isCompanyMember(companyId) && (
        companyDoc(companyId).data.ownerId == request.auth.uid
        || (permission in overrides ? overrides[permission] == true : (
          role in ['owner', 'co-owner']
          || (role == 'technician' && permission in ['useOrson', 'viewFarm', 'viewAssets', 'manageLabReports', 'manageAssets', 'logAssetMaintenance'])
          || (role in ['manager', 'admin', 'mechanic'] && permission in ['viewFarm', 'viewAssets'])
          || (role in ['manager', 'admin'] && permission == 'useOrson')
          || (role == 'mechanic' && permission == 'logAssetMaintenance')
        ))
      );
    }

    function canWriteLabReportSource(companyId, labReportId) {
      return labReportDoc(companyId, labReportId).data == null
        || labReportDoc(companyId, labReportId).data.status != 'confirmed';
    }

    match /companies/{companyId}/orsonTemp/{uid}/{uploadId} {
      allow read: if request.auth != null && request.auth.uid == uid
        && hasCompanyPermission(companyId, 'useOrson');
      allow write: if request.auth != null && request.auth.uid == uid
        && hasCompanyPermission(companyId, 'useOrson')
        && (request.resource == null || (request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf', 'text/csv']));
    }

    match /companies/{companyId}/labReports/{labReportId}/source.pdf {
      allow read: if hasCompanyPermission(companyId, 'viewFarm');
      allow write: if hasCompanyPermission(companyId, 'manageLabReports')
        && canWriteLabReportSource(companyId, labReportId)
        && (request.resource == null || (request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && request.resource.metadata.companyId == companyId
        && request.resource.metadata.labReportId == labReportId));
    }

    match /companies/{companyId}/assets/{assetId}/{allPaths=**} {
      allow read: if hasCompanyPermission(companyId, 'viewAssets');
      allow write: if hasCompanyPermission(companyId, 'manageAssets')
        && (request.resource == null || (request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.companyId == companyId
        && request.resource.metadata.assetId == assetId));
    }

    match /companies/{companyId}/assets/{assetId}/maintenance/{fileName} {
      allow read: if hasCompanyPermission(companyId, 'viewAssets');
      allow write: if hasCompanyPermission(companyId, 'logAssetMaintenance')
        && (request.resource == null || (request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*')
          && request.resource.metadata.companyId == companyId
          && request.resource.metadata.assetId == assetId));
    }

    function canManageSop(companyId) {
      return isCompanyMember(companyId) && (companyDoc(companyId).data.ownerId == request.auth.uid
        || userDoc().data.role in ['owner', 'co-owner', 'manager']);
    }
    function canAccessSopTask(companyId, taskId) {
      let task = firestore.get(/databases/(default)/documents/companies/$(companyId)/tasks/$(taskId));
      let company = companyDoc(companyId).data;
      let user = userDoc().data;
      let target = task.data.get('target', {});
      return task.data != null && request.auth.uid in task.data.visibleTo
        && (company.get('businessSize','small') != 'enterprise' || user.get('role','') != 'technician'
          || target.get('scope','') == 'company'
          || (target.get('blockId','') != '' && firestore.get(/databases/(default)/documents/companies/$(companyId)/blocks/$(target.blockId)).data.assignedTechnicianId == request.auth.uid));
    }
    match /companies/{companyId}/sopAttachments/{uid}/{fileName} {
      allow read: if currentSessionAllowed() && hasCompanyPermission(companyId, 'viewFarm')
        && (request.auth.uid == uid || canManageSop(companyId) || resource.metadata.get('taskId', '') == 'guidance'
          || canAccessSopTask(companyId, resource.metadata.get('taskId', 'missing')));
      allow create: if currentSessionAllowed() && hasCompanyPermission(companyId, 'viewFarm') && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp','application/pdf','text/plain','application/vnd.openxmlformats-officedocument.wordprocessingml.document']
        && request.resource.metadata.companyId == companyId;
      allow update, delete: if false;
    }

    match /communitySops/{publicationId}/{fileName} {
      allow read: if currentSessionAllowed() && hasCompanyPermission(userDoc().data.companyId, 'viewFarm')
        && firestore.get(/databases/(default)/documents/communitySops/$(publicationId)).data.status == 'published';
      allow write: if false;
    }
    match /users/{userId}/profile/{fileName} {
      allow read: if currentSessionAllowed();
      allow write: if currentSessionAllowed()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
