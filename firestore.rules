rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFounderAdmin() {
      return signedIn()
        && (
          ('platformOwner' in request.auth.token && request.auth.token.platformOwner == true)
          || ('platformRole' in request.auth.token && request.auth.token.platformRole == 'owner')
        );
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    function isCompanyMember(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && (
          companyDoc(companyId).data.ownerId == request.auth.uid
          || (
            companyDoc(companyId).data.teamMembers.hasAny([request.auth.uid])
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && userDoc().data.companyId == companyId
          )
        );
    }

    function isCompanyOwner(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && companyDoc(companyId).data.ownerId == request.auth.uid;
    }

    function validNonEmptyString(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }

    function validOptionalString(data, key, maxLength) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLength);
    }

    function validOptionalNullableString(data, key, maxLength) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLength);
    }

    function validOptionalBoolean(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function validOptionalNumber(data, key) {
      return !(key in data) || data[key] is number;
    }

    function validOptionalTimestamp(data, key) {
      return !(key in data) || data[key] is timestamp;
    }

    function validRoleValue(value) {
      return value == null || value in ['owner', 'co-owner', 'manager', 'technician', 'admin', 'buyer', 'mechanic'];
    }

    function validStaffRoleValue(value) {
      return value in ['co-owner', 'manager', 'technician', 'admin', 'mechanic'];
    }

    function currentUserRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().data.role
        : null;
    }

    function userBelongsToCompany(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.companyId == companyId;
    }

    function isCompanyOwnerRole(companyId) {
      return isCompanyMember(companyId)
        && (
          isCompanyOwner(companyId)
          || (
            userBelongsToCompany(companyId)
            && currentUserRole() in ['owner', 'co-owner']
          )
        );
    }

    function isCompanyManager(companyId) {
      return isCompanyMember(companyId)
        && (
          isCompanyOwner(companyId)
          || (
            userBelongsToCompany(companyId)
            && currentUserRole() in ['owner', 'co-owner', 'manager', 'admin']
          )
        );
    }

    function isCompanyOperator(companyId) {
      return isCompanyMember(companyId)
        && (
          isCompanyOwner(companyId)
          || (
            userBelongsToCompany(companyId)
            && currentUserRole() in ['owner', 'co-owner', 'technician']
          )
        );
    }

    function isCompanyMechanic(companyId) {
      return isCompanyMember(companyId)
        && userBelongsToCompany(companyId)
        && currentUserRole() == 'mechanic';
    }

    function validMechanicAssetUpdate() {
      return request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'maintenanceHistory',
          'totalMaintenanceCost',
          'nextMaintenanceDue',
          'lastMaintenanceDate',
          'condition',
          'updatedAt'
        ]);
    }

    function validUserPayload(data) {
      return (!('uid' in data) || data.uid == request.auth.uid)
        && (!('id' in data) || data.id == request.auth.uid)
        && validNonEmptyString(data.email)
        && validOptionalString(data, 'name', 120)
        && validOptionalString(data, 'phone', 40)
        && validOptionalString(data, 'profileImage', 2000)
        && validOptionalNullableString(data, 'companyId', 160)
        && (!('role' in data) || validRoleValue(data.role))
        && validOptionalBoolean(data, 'hasCompletedSetup');
    }

    function validCompanyPayload(data) {
      return data.ownerId is string
        && data.teamMembers is list
        && data.teamMembers.hasAny([data.ownerId])
        && (!('companyName' in data) || validNonEmptyString(data.companyName))
        && validOptionalString(data, 'businessType', 120)
        && validOptionalString(data, 'farmType', 120)
        && validOptionalString(data, 'businessSize', 120)
        && validOptionalString(data, 'description', 2000)
        && validOptionalString(data, 'contactPhone', 40)
        && validOptionalBoolean(data, 'isSearchable')
        && validOptionalBoolean(data, 'isPublicProfile')
        && validOptionalBoolean(data, 'isVerified');
    }

    function validRequiredCompanySetup(data) {
      return validNonEmptyString(data.companyName)
        && validNonEmptyString(data.farmType)
        && validNonEmptyString(data.businessSize)
        && 'primaryLocation' in data
        && (
          validNonEmptyString(data.primaryLocation)
          || (
            data.primaryLocation is map
            && 'address' in data.primaryLocation
            && validNonEmptyString(data.primaryLocation.address)
          )
        );
    }

    function validFarmBlockPayload(data, companyId) {
      return data.keys().hasOnly([
          'companyId',
          'name',
          'assignedTechnicianId',
          'assignedTechnicianName',
          'assignedTechnicianEmail',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && data.companyId == companyId
        && validNonEmptyString(data.name)
        && validOptionalNullableString(data, 'assignedTechnicianId', 160)
        && validOptionalNullableString(data, 'assignedTechnicianName', 120)
        && validOptionalNullableString(data, 'assignedTechnicianEmail', 200)
        && validOptionalTimestamp(data, 'createdAt')
        && validOptionalString(data, 'createdBy', 160)
        && validOptionalTimestamp(data, 'updatedAt')
        && validOptionalString(data, 'updatedBy', 160)
        && (
          !('assignedTechnicianId' in data)
          || data.assignedTechnicianId == null
          || (
            exists(/databases/$(database)/documents/users/$(data.assignedTechnicianId))
            && get(/databases/$(database)/documents/users/$(data.assignedTechnicianId)).data.companyId == companyId
            && get(/databases/$(database)/documents/users/$(data.assignedTechnicianId)).data.role == 'technician'
          )
        );
    }

    function validEnterprisePondBlock(companyId, data) {
      return !('businessSize' in companyDoc(companyId).data)
        || companyDoc(companyId).data.businessSize != 'enterprise'
        || isCompanyOwnerRole(companyId)
        || (
          data.blockId is string
          && exists(/databases/$(database)/documents/companies/$(companyId)/blocks/$(data.blockId))
          && get(/databases/$(database)/documents/companies/$(companyId)/blocks/$(data.blockId)).data.assignedTechnicianId == request.auth.uid
        );
    }

    function validEnterprisePondCycle(companyId, data) {
      return !('businessSize' in companyDoc(companyId).data)
        || companyDoc(companyId).data.businessSize != 'enterprise'
        || isCompanyOwnerRole(companyId)
        || !('cycleId' in data)
        || (
          data.cycleId is string
          && exists(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId))
          && (
            (
              'blockIds' in get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data
              && get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data.blockIds is list
              && data.blockId in get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data.blockIds
            )
            || (
              !('blockIds' in get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data)
              && (
                !('blockId' in get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data)
                || get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data.blockId == data.blockId
              )
            )
          )
          && (
            'blockIds' in get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data
            ||
            !('plannedPondIds' in get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data)
            || get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data.plannedPondIds.size() == 0
            || (
              'physicalPondId' in data
              && data.physicalPondId in get(/databases/$(database)/documents/companies/$(companyId)/cycles/$(data.cycleId)).data.plannedPondIds
            )
          )
        );
    }

    function validJoinRequestCreate(data) {
      return validNonEmptyString(data.companyId)
        && data.userId == request.auth.uid
        && validOptionalString(data, 'userName', 120)
        && validOptionalString(data, 'userEmail', 200)
        && validStaffRoleValue(data.requestedRole)
        && data.status == 'pending';
    }

    function validOptionalUsageCount(data, key, max) {
      return !(key in data) || (data[key] is int && data[key] >= 0 && data[key] <= max);
    }

    function validAiUsagePayload(data, usageDateId) {
      return data.dateKey == usageDateId
        && data.updatedAt is timestamp
        && data.functions is map
        && data.functions.keys().hasOnly(['chat', 'projection'])
        && validOptionalUsageCount(data.functions, 'chat', 20)
        && validOptionalUsageCount(data.functions, 'projection', 5);
    }

    function aiUsageChatCount(data) {
      return 'chat' in data.functions ? data.functions.chat : 0;
    }

    function aiUsageProjectionCount(data) {
      return 'projection' in data.functions ? data.functions.projection : 0;
    }

    function validLegacyAiUsageCreate(data, usageDateId) {
      return validAiUsagePayload(data, usageDateId)
        && (
          (aiUsageChatCount(data) == 1 && aiUsageProjectionCount(data) == 0)
          || (aiUsageChatCount(data) == 0 && aiUsageProjectionCount(data) == 1)
        );
    }

    function validLegacyAiUsageUpdate(data, usageDateId) {
      return validAiUsagePayload(data, usageDateId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['functions', 'updatedAt'])
        && (
          (
            aiUsageChatCount(data) == aiUsageChatCount(resource.data) + 1
            && aiUsageProjectionCount(data) == aiUsageProjectionCount(resource.data)
          )
          || (
            aiUsageProjectionCount(data) == aiUsageProjectionCount(resource.data) + 1
            && aiUsageChatCount(data) == aiUsageChatCount(resource.data)
          )
        );
    }

    function validActivitySessionPayload(data, companyId) {
      return data.keys().hasOnly([
          'companyId',
          'userId',
          'userName',
          'userEmail',
          'role',
          'platform',
          'status',
          'startedAt',
          'lastSeenAt',
          'endedAt',
          'durationSeconds',
          'createdAt',
          'updatedAt'
        ])
        && data.companyId == companyId
        && data.userId is string
        && data.userId.size() > 0
        && validNonEmptyString(data.userName)
        && validOptionalString(data, 'userEmail', 200)
        && (!('role' in data) || validRoleValue(data.role))
        && data.platform == 'mobile'
        && data.status in ['active', 'ended']
        && data.startedAt is timestamp
        && data.lastSeenAt is timestamp
        && (data.endedAt == null || data.endedAt is timestamp)
        && data.durationSeconds is int
        && data.durationSeconds >= 0
        && data.durationSeconds <= 86400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validActivitySessionCreate(data, companyId) {
      return validActivitySessionPayload(data, companyId)
        && data.userId == request.auth.uid
        && data.status == 'active'
        && data.endedAt == null
        && data.durationSeconds == 0;
    }

    function validActivitySessionUpdate(data, companyId) {
      return validActivitySessionPayload(data, companyId)
        && resource.data.companyId == companyId
        && resource.data.userId == request.auth.uid
        && data.userId == resource.data.userId
        && data.companyId == resource.data.companyId
        && data.startedAt == resource.data.startedAt
        && data.createdAt == resource.data.createdAt
        && data.durationSeconds >= resource.data.durationSeconds
        && data.durationSeconds <= resource.data.durationSeconds + 900;
    }

    function validActivityDailyPayload(data, companyId) {
      return data.keys().hasOnly([
          'companyId',
          'userId',
          'userName',
          'userEmail',
          'role',
          'platform',
          'dateKey',
          'totalSeconds',
          'sessionCount',
          'lastSeenAt',
          'createdAt',
          'updatedAt'
        ])
        && data.companyId == companyId
        && data.userId is string
        && data.userId.size() > 0
        && validNonEmptyString(data.userName)
        && validOptionalString(data, 'userEmail', 200)
        && (!('role' in data) || validRoleValue(data.role))
        && data.platform == 'mobile'
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.totalSeconds is int
        && data.totalSeconds >= 0
        && data.totalSeconds <= 86400
        && data.sessionCount is int
        && data.sessionCount >= 0
        && data.sessionCount <= 100
        && data.lastSeenAt is timestamp
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function validActivityDailyCreate(data, companyId) {
      return validActivityDailyPayload(data, companyId)
        && data.userId == request.auth.uid;
    }

    function validActivityDailyUpdate(data, companyId) {
      return validActivityDailyPayload(data, companyId)
        && resource.data.companyId == companyId
        && resource.data.userId == request.auth.uid
        && data.userId == resource.data.userId
        && data.companyId == resource.data.companyId
        && data.dateKey == resource.data.dateKey
        && data.totalSeconds >= resource.data.totalSeconds
        && data.totalSeconds <= resource.data.totalSeconds + 900
        && data.sessionCount >= resource.data.sessionCount
        && data.sessionCount <= resource.data.sessionCount + 1;
    }

    function validNotificationCreate(data) {
      return data.keys().hasOnly([
          'companyId',
          'userId',
          'type',
          'title',
          'message',
          'timestamp',
          'read',
          'priority',
          'data',
          'icon',
          'color',
          'isOrson',
          'dedupeKey',
          'riskSignature',
          'pondId',
          'pondName',
          'orsonRiskReport',
          'evidence',
          'confidence'
        ])
        && validNonEmptyString(data.companyId)
        && data.type in [
          'disease_alert',
          'system',
          'team',
          'buyer',
          'feed_low_stock',
          'asset_overdue',
          'orson_risk',
          'orson_daily_brief',
          'inventory_forecast',
          'orson_biosecurity'
        ]
        && validOptionalString(data, 'title', 240)
        && validOptionalString(data, 'message', 1000)
        && data.timestamp is timestamp
        && data.read is bool
        && data.priority in ['high', 'medium', 'low']
        && (!('data' in data) || data.data is map)
        && validOptionalString(data, 'icon', 80)
        && validOptionalString(data, 'color', 40)
        && validOptionalBoolean(data, 'isOrson')
        && validOptionalString(data, 'dedupeKey', 240)
        && validOptionalString(data, 'riskSignature', 240)
        && validOptionalNullableString(data, 'pondId', 160)
        && validOptionalString(data, 'pondName', 200)
        && (!('evidence' in data) || data.evidence is list)
        && validOptionalNumber(data, 'confidence')
        && (
          !('userId' in data)
          || (
            data.userId is string
            && exists(/databases/$(database)/documents/users/$(data.userId))
            && get(/databases/$(database)/documents/users/$(data.userId)).data.companyId == data.companyId
          )
        );
    }

    function validNotificationReadUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }

    function validDiseaseReportLocation(location) {
      return location is map
        && location.keys().hasOnly(['address', 'latitude', 'longitude'])
        && validOptionalString(location, 'address', 500)
        && location.latitude is number
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude is number
        && location.longitude >= -180
        && location.longitude <= 180;
    }

    function validDiseaseReportCreate(data) {
      return data.keys().hasOnly([
          'companyId',
          'companyName',
          'location',
          'diseaseType',
          'diseaseName',
          'severity',
          'color',
          'affectedPonds',
          'estimatedLoss',
          'symptoms',
          'actionsTaken',
          'reportDate',
          'status',
          'notificationRadius',
          'createdAt',
          'updatedAt'
        ])
        && validNonEmptyString(data.companyId)
        && isCompanyMember(data.companyId)
        && validOptionalString(data, 'companyName', 200)
        && validDiseaseReportLocation(data.location)
        && validNonEmptyString(data.diseaseType)
        && validOptionalString(data, 'diseaseName', 200)
        && data.severity in ['low', 'medium', 'high', 'critical']
        && validOptionalString(data, 'color', 40)
        && data.affectedPonds is int
        && data.affectedPonds >= 0
        && validOptionalString(data, 'estimatedLoss', 200)
        && validNonEmptyString(data.symptoms)
        && validOptionalString(data, 'actionsTaken', 2000)
        && data.reportDate is timestamp
        && data.status == 'active'
        && data.notificationRadius in [10, 25, 50, 100]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validDiseaseReportStatusUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.status in ['contained', 'resolved']
        && request.resource.data.updatedAt is timestamp;
    }

    function validPublicCompanyProfile(data, companyId) {
      return data.keys().hasOnly([
          'companyId',
          'companyName',
          'location',
          'country',
          'farmType',
          'businessSize',
          'description',
          'contactPhone',
          'isPublicProfile',
          'publicMemberCount',
          'publicPondCount',
          'publicAverageDOC',
          'publicAverageSize',
          'publicAverageBiomass',
          'updatedAt'
        ])
        && data.companyId == companyId
        && validNonEmptyString(data.companyName)
        && validOptionalString(data, 'location', 300)
        && validOptionalString(data, 'country', 120)
        && validOptionalString(data, 'farmType', 120)
        && validOptionalString(data, 'businessSize', 120)
        && validOptionalString(data, 'description', 2000)
        && validOptionalString(data, 'contactPhone', 40)
        && data.isPublicProfile is bool
        && data.updatedAt is timestamp
        && (!('publicMemberCount' in data) || (data.publicMemberCount is int && data.publicMemberCount >= 0))
        && (!('publicPondCount' in data) || (data.publicPondCount is number && data.publicPondCount >= 0))
        && (!('publicAverageDOC' in data) || (data.publicAverageDOC is number && data.publicAverageDOC >= 0))
        && (!('publicAverageSize' in data) || (data.publicAverageSize is number && data.publicAverageSize >= 0))
        && (!('publicAverageBiomass' in data) || (data.publicAverageBiomass is number && data.publicAverageBiomass >= 0));
    }

    function validPublicMemberCountUpdate(companyId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'publicMemberCount',
          'updatedAt'
        ])
        && request.resource.data.companyId == companyId
        && request.resource.data.publicMemberCount is int
        && request.resource.data.publicMemberCount >= 0
        && request.resource.data.updatedAt is timestamp;
    }

    function marketplaceListingDoc(listingId) {
      return get(/databases/$(database)/documents/marketplace_listings/$(listingId));
    }

    function marketplaceListingExists(listingId) {
      return listingId is string
        && exists(/databases/$(database)/documents/marketplace_listings/$(listingId));
    }

    function validMarketplacePriceList(value) {
      return value is map
        && value.keys().hasOnly([
          'size20',
          'size30',
          'size40',
          'size50',
          'size60',
          'size70',
          'size80',
          'size90',
          'size100',
          'size100Plus'
        ]);
    }

    function validOptionalMarketplacePriceList(data, key) {
      return !(key in data) || validMarketplacePriceList(data[key]);
    }

    function validMarketplaceListingPayload(data) {
      return data.keys().hasOnly([
          'companyId',
          'companyName',
          'buyerName',
          'contactPhone',
          'contactEmail',
          'deliveryLocation',
          'city',
          'latitude',
          'longitude',
          'country',
          'priceList',
          'paymentMethod',
          'topDays',
          'additionalNotes',
          'postedDate',
          'expiryDate',
          'viewCount',
          'status',
          'userId',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && validNonEmptyString(data.companyId)
        && validOptionalString(data, 'companyName', 200)
        && validOptionalString(data, 'buyerName', 200)
        && validOptionalString(data, 'contactPhone', 80)
        && validOptionalString(data, 'contactEmail', 200)
        && validOptionalString(data, 'deliveryLocation', 500)
        && validOptionalString(data, 'city', 160)
        && validOptionalString(data, 'country', 120)
        && validOptionalMarketplacePriceList(data, 'priceList')
        && data.paymentMethod in ['cash', 'top']
        && validOptionalNumber(data, 'topDays')
        && validOptionalString(data, 'additionalNotes', 2000)
        && validOptionalString(data, 'postedDate', 80)
        && validOptionalString(data, 'expiryDate', 80)
        && validOptionalNumber(data, 'latitude')
        && validOptionalNumber(data, 'longitude')
        && data.viewCount is int
        && data.viewCount >= 0
        && data.status in ['active', 'expired']
        && data.userId is string
        && data.createdBy is string
        && validOptionalTimestamp(data, 'createdAt')
        && validOptionalTimestamp(data, 'updatedAt');
    }

    function isMarketplaceListingOwner(data) {
      return data.userId == request.auth.uid
        || data.createdBy == request.auth.uid
        || isCompanyOwnerRole(data.companyId);
    }

    function validMarketplaceListingCreate(data) {
      return validMarketplaceListingPayload(data)
        && isCompanyMember(data.companyId)
        && data.userId == request.auth.uid
        && data.createdBy == request.auth.uid
        && data.viewCount == 0
        && data.status == 'active';
    }

    function validMarketplaceListingUpdate() {
      return validMarketplaceListingPayload(request.resource.data)
        && isMarketplaceListingOwner(resource.data)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validMarketplaceViewCountUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['viewCount'])
        && resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.viewCount + 1;
    }

    function validMarketplaceResponsePayload(data) {
      return data.keys().hasOnly([
          'listingId',
          'sellerId',
          'sellerName',
          'sellerCompany',
          'message',
          'proposedPrice',
          'contactPhone',
          'contactEmail',
          'responseDate',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.listingId is string
        && data.sellerId is string
        && validOptionalString(data, 'sellerName', 200)
        && validOptionalString(data, 'sellerCompany', 200)
        && validOptionalString(data, 'message', 2000)
        && validOptionalMarketplacePriceList(data, 'proposedPrice')
        && validOptionalString(data, 'contactPhone', 80)
        && validOptionalString(data, 'contactEmail', 200)
        && validOptionalString(data, 'responseDate', 80)
        && data.status in ['pending', 'accepted', 'rejected']
        && validOptionalTimestamp(data, 'createdAt')
        && validOptionalTimestamp(data, 'updatedAt');
    }

    function validMarketplaceResponseCreate(data) {
      return validMarketplaceResponsePayload(data)
        && marketplaceListingExists(data.listingId)
        && isCompanyMember(data.sellerId)
        && marketplaceListingDoc(data.listingId).data.companyId != data.sellerId
        && marketplaceListingDoc(data.listingId).data.status == 'active'
        && data.status == 'pending';
    }

    function isMarketplaceResponseBuyer(data) {
      return marketplaceListingExists(data.listingId)
        && isCompanyMember(marketplaceListingDoc(data.listingId).data.companyId);
    }

    function validMarketplaceResponseStatusUpdate() {
      return validMarketplaceResponsePayload(request.resource.data)
        && isMarketplaceResponseBuyer(resource.data)
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt']);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && validUserPayload(request.resource.data);
      allow read: if signedIn() && (
        isFounderAdmin()
        || request.auth.uid == userId
        || (resource.data.companyId != null && isCompanyMember(resource.data.companyId))
      );
      allow update: if signedIn() && (
        (
          request.auth.uid == userId
          && validUserPayload(request.resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'name',
            'phone',
            'profileImage',
            'lastActive',
            'businessName',
            'region',
            'interests'
          ])
        )
        || (
          request.auth.uid == userId
          && validUserPayload(request.resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['role', 'hasCompletedSetup', 'lastActive'])
          && (!('companyId' in resource.data) || resource.data.companyId == null)
          && (!('companyId' in request.resource.data) || request.resource.data.companyId == null)
        )
        || (
          request.auth.uid == userId
          && validUserPayload(request.resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['companyId', 'hasCompletedSetup', 'lastActive'])
          && request.resource.data.companyId != null
          && (!('companyId' in resource.data) || resource.data.companyId == null || resource.data.companyId == request.resource.data.companyId)
          && isCompanyOwner(request.resource.data.companyId)
          && validRequiredCompanySetup(companyDoc(request.resource.data.companyId).data)
        )
      );
      allow delete: if isFounderAdmin();

      match /monitoredCompanies/{companyId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('companyId' in userDoc().data) || userDoc().data.companyId == null)
        && validCompanyPayload(request.resource.data)
        && validRequiredCompanySetup(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.teamMembers.hasAny([request.auth.uid]);
      allow read: if signedIn() && (
        isFounderAdmin()
        || isCompanyMember(companyId)
      );
      allow update: if isFounderAdmin()
        || (
          isCompanyMember(companyId)
          && validCompanyPayload(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && (
            isCompanyManager(companyId)
            && !request.resource.data.diff(resource.data).changedKeys().hasAny([
              'ownerId',
              'teamMembers',
              'pendingInvites',
              'isVerified'
            ])
          )
        );
      allow delete: if isCompanyOwner(companyId) || isFounderAdmin();

      match /blocks/{blockId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow create: if isCompanyOwnerRole(companyId)
          && validFarmBlockPayload(request.resource.data, companyId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isCompanyOwnerRole(companyId)
          && validFarmBlockPayload(request.resource.data, companyId)
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isCompanyOwnerRole(companyId) || isFounderAdmin();
      }

      match /ponds/{pondId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow create, update: if isCompanyOperator(companyId)
          && validEnterprisePondBlock(companyId, request.resource.data)
          && validEnterprisePondCycle(companyId, request.resource.data);
        allow delete: if (isCompanyOperator(companyId)
          && validEnterprisePondBlock(companyId, resource.data)) || isFounderAdmin();

        match /labSummaries/{labReportId} {
          allow read: if isFounderAdmin() || isCompanyMember(companyId);
          allow write: if isFounderAdmin();
        }

        match /planktonOverwatchHistory/{evaluationId} {
          allow read: if isFounderAdmin() || isCompanyMember(companyId);
          allow write: if isFounderAdmin();
        }
      }

      match /labReports/{labReportId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow create: if isCompanyOperator(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.status in ['draft', 'extracted', 'confirmed', 'failed']
          && request.resource.data.entryMode in ['manual', 'pdf_upload'];
        allow update: if isCompanyOperator(companyId)
          && resource.data.status != 'confirmed'
          && request.resource.data.companyId == companyId
          && request.resource.data.status in ['draft', 'extracted', 'confirmed', 'failed']
          && request.resource.data.entryMode in ['manual', 'pdf_upload'];
        allow delete: if isCompanyOwnerRole(companyId) || isFounderAdmin();
      }

      match /labUsage/{usageId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin();
      }

      match /physicalPonds/{physicalPondId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow create, update: if isCompanyOperator(companyId)
          && validEnterprisePondBlock(companyId, request.resource.data);
        allow delete: if (isCompanyOperator(companyId)
          && validEnterprisePondBlock(companyId, resource.data)) || isFounderAdmin();
      }

      match /cycles/{cycleId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin() || (isCompanyOperator(companyId)
          && (
            !('businessSize' in companyDoc(companyId).data)
            || companyDoc(companyId).data.businessSize != 'enterprise'
            || isCompanyOwnerRole(companyId)
          ));
      }

      match /harvestRecords/{harvestId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin() || isCompanyOperator(companyId);
      }

      match /feeds/{feedId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin() || isCompanyOperator(companyId);
      }

      match /additives/{additiveId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin() || isCompanyOperator(companyId);
      }

      match /expenses/{expenseId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow create, update: if isCompanyManager(companyId)
          || (
            isCompanyOperator(companyId)
            && expenseId.matches('sync_INVENTORY-.*')
            && request.resource.data.companyId == companyId
            && request.resource.data.reference.matches('INVENTORY-.*')
          );
        allow delete: if isFounderAdmin()
          || isCompanyManager(companyId)
          || (isCompanyOperator(companyId)
            && expenseId.matches('sync_INVENTORY-.*')
            && resource.data.reference.matches('INVENTORY-.*'));
      }

      match /revenues/{revenueId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow create, update: if isCompanyManager(companyId)
          || (
            isCompanyOperator(companyId)
            && revenueId.matches('sync_HARVEST-.*')
            && request.resource.data.companyId == companyId
            && request.resource.data.reference.matches('HARVEST-.*')
          );
        allow delete: if isFounderAdmin()
          || isCompanyManager(companyId)
          || (isCompanyOperator(companyId)
            && revenueId.matches('sync_HARVEST-.*')
            && resource.data.reference.matches('HARVEST-.*'));
      }

      match /billing/{docId} {
        allow read, write: if isFounderAdmin();
      }

      match /billingPayments/{paymentId} {
        allow read, write: if isFounderAdmin();
      }

      // Legacy client-visible counters. Existing installed clients still reserve
      // here before calling Orson, so keep that path backward-compatible but prevent
      // resets, jumps, or changes to both counters in one write.
      match /aiUsage/{usageDateId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow create: if isCompanyMember(companyId)
          && validLegacyAiUsageCreate(request.resource.data, usageDateId);
        allow update: if isCompanyMember(companyId)
          && validLegacyAiUsageUpdate(request.resource.data, usageDateId);
        allow delete: if isFounderAdmin();
      }

      // Authoritative Orson quotas live here. Only Cloud Functions/Admin SDK writes
      // these counters; client SDKs can never reserve, reset, or forge them.
      match /orsonUsage/{usageDateId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin();
      }

      match /orsonPredictions/{predictionId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin();
      }

      match /orsonCycleOutcomes/{outcomeId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin();
      }

      match /orsonCalibration/{calibrationId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin();
      }

      match /orsonCalibrationEvaluations/{evaluationId} {
        allow read: if isFounderAdmin() || isCompanyMember(companyId);
        allow write: if isFounderAdmin();
      }

      match /userActivitySessions/{sessionId} {
        allow read: if isFounderAdmin()
          || isCompanyManager(companyId)
          || (isCompanyMember(companyId) && resource.data.userId == request.auth.uid);
        allow create: if isCompanyMember(companyId)
          && validActivitySessionCreate(request.resource.data, companyId);
        allow update: if isCompanyMember(companyId)
          && validActivitySessionUpdate(request.resource.data, companyId);
        allow delete: if isFounderAdmin();
      }

      match /userActivityDaily/{summaryId} {
        allow read: if isFounderAdmin()
          || isCompanyManager(companyId)
          || (isCompanyMember(companyId) && resource.data.userId == request.auth.uid);
        allow create: if isCompanyMember(companyId)
          && validActivityDailyCreate(request.resource.data, companyId);
        allow update: if isCompanyMember(companyId)
          && validActivityDailyUpdate(request.resource.data, companyId);
        allow delete: if isFounderAdmin();
      }
    }

    match /publicCompanyProfiles/{companyId} {
      allow read: if signedIn() && (
        isFounderAdmin()
        || resource.data.isPublicProfile == true
        || isCompanyMember(companyId)
      );
      allow create: if signedIn()
        && isCompanyManager(companyId)
        && validPublicCompanyProfile(request.resource.data, companyId);
      allow update: if signedIn()
        && isCompanyManager(companyId)
        && (
          validPublicCompanyProfile(request.resource.data, companyId)
          || validPublicMemberCountUpdate(companyId)
        );
      allow delete: if signedIn() && isCompanyManager(companyId);
    }

    match /joinRequests/{requestId} {
      allow create: if false;
      allow read: if signedIn() && (
        isFounderAdmin()
        || resource.data.userId == request.auth.uid
        || isCompanyOwnerRole(resource.data.companyId)
      );
      allow update: if false;
      allow delete: if isFounderAdmin();
    }

    match /companyInvites/{inviteId} {
      allow read, write: if false;
    }

    match /securityRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn()
        && isCompanyMember(request.resource.data.companyId)
        && validNotificationCreate(request.resource.data);
      allow read: if signedIn() && (
        isFounderAdmin()
        || isCompanyMember(resource.data.companyId)
      );
      allow update: if signedIn()
        && isCompanyMember(resource.data.companyId)
        && validNotificationReadUpdate();
      allow delete: if signedIn() && isCompanyMember(resource.data.companyId);
    }

    match /diseaseReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && validDiseaseReportCreate(request.resource.data);
      allow update: if signedIn()
        && isCompanyManager(resource.data.companyId)
        && validDiseaseReportStatusUpdate();
      allow delete: if signedIn() && (isCompanyManager(resource.data.companyId) || isFounderAdmin());
    }

    match /marketplace_listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && validMarketplaceListingCreate(request.resource.data);
      allow update: if signedIn() && (
        validMarketplaceListingUpdate()
        || validMarketplaceViewCountUpdate()
      );
      allow delete: if signedIn() && isMarketplaceListingOwner(resource.data);
    }

    match /marketplace_responses/{responseId} {
      allow read: if signedIn() && (
        isCompanyMember(resource.data.sellerId)
        || isMarketplaceResponseBuyer(resource.data)
      );
      allow create: if signedIn() && validMarketplaceResponseCreate(request.resource.data);
      allow update: if signedIn() && validMarketplaceResponseStatusUpdate();
      allow delete: if signedIn() && (
        isCompanyMember(resource.data.sellerId)
        || isMarketplaceResponseBuyer(resource.data)
      );
    }

    match /assets/{assetId} {
      allow create: if signedIn() && isCompanyOperator(request.resource.data.companyId);
      allow read: if signedIn() && (
        isFounderAdmin()
        || isCompanyMember(resource.data.companyId)
      );
      allow update: if signedIn() && (
        isCompanyOperator(resource.data.companyId)
        || (isCompanyMechanic(resource.data.companyId) && validMechanicAssetUpdate())
      );
      allow delete: if signedIn() && isCompanyOperator(resource.data.companyId);
    }

    match /apiRequests/{requestId} {
      allow read: if isFounderAdmin();
      allow write: if false;
    }

    match /requestLogs/{requestId} {
      allow read: if isFounderAdmin();
      allow write: if false;
    }

    match /adminAuditEvents/{eventId} {
      allow read, create: if isFounderAdmin();
      allow update, delete: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if isFounderAdmin();
      allow write: if false;
    }

    match /testerRequests/{requestId} {
      allow read: if isFounderAdmin();
      allow write: if false;
    }

    match /{path=**}/aiUsage/{usageDateId} {
      allow read: if isFounderAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
