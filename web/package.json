{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ../scripts/sync-web-pdf-generators.cjs",
    "dev": "next dev --webpack",
    "prebuild": "npm run test:permissions && node ../scripts/sync-web-pdf-generators.cjs && node scripts/validate-public-env.cjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:permissions": "node --test src/hooks/useFarmPermissions.test.cjs src/app/dashboard/permissionControls.test.cjs ../functions/shared/permissions.test.js",
    "test:cursor": "node --test src/components/Cursor.test.cjs",
    "test:dashboard-summary-ui": "node --test src/app/dashboard/dashboardSummaryUi.test.cjs",
    "test:enterprise-cycle-ui": "node --test src/components/enterpriseCycleUi.test.cjs",
    "test:authenticated-ui": "node --test src/app/dashboard/authenticatedUi.test.cjs",
    "test:auth-startup": "node --test src/contexts/authStartup.test.cjs",
    "test:feed-ui": "node --test src/app/dashboard/feed/feedUi.test.cjs",
    "test:inventory-layout": "node --test src/app/dashboard/inventory/feeds/inventoryMetricLayout.test.cjs",
    "test:navbar-ui": "node --test src/components/navbarUi.test.cjs",
    "test:pond-detail-ui": "node --test src/app/dashboard/ponds/detail/pondDetailUi.test.cjs",
    "test:ponds-ui": "node --test src/app/dashboard/ponds/pondsUi.test.cjs",
    "test:water-quality-ui": "node --test src/app/dashboard/water/waterQualityUi.test.cjs",
    "test:water-quality-state": "node --test src/app/dashboard/water/labRowState.test.cjs",
    "test:mobile-pdf": "node --test src/lib/mobilePdfExport.test.cjs",
    "test:signup-location": "node --test src/lib/googlePlacesClient.test.cjs",
    "test:dev-bundler": "node --test scripts/dev-bundler.test.cjs",
    "test:vercel-build-path": "node --test scripts/vercel-build-path.test.cjs"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.8.0",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5"
  }
}
