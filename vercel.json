{
  "framework": null,
  "installCommand": "npm ci && npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/out",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/firebase-auth/identitytoolkit/:path*",
      "destination": "https://identitytoolkit.googleapis.com/:path*"
    },
    {
      "source": "/firebase-auth/securetoken/:path*",
      "destination": "https://securetoken.googleapis.com/:path*"
    },
    {
      "source": "/api/sites-mcp/status",
      "destination": "https://us-central1-investashrimp-5d9e5.cloudfunctions.net/readOnlyApi/api/integrations/v1/site-delegation/status"
    },
    {
      "source": "/api/sites-mcp/pair",
      "destination": "https://us-central1-investashrimp-5d9e5.cloudfunctions.net/readOnlyApi/api/integrations/v1/site-delegation/pair-complete"
    },
    {
      "source": "/api/sites-mcp/revoke",
      "destination": "https://us-central1-investashrimp-5d9e5.cloudfunctions.net/readOnlyApi/api/integrations/v1/site-delegation/revoke"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "shrimplytech.com"
        }
      ],
      "destination": "https://www.shrimplytech.com/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/roleselection",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/setup/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
